VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

RESEND_API_KEY=

# Server only. Never prefix these with VITE_. Leave them empty in git.
# Generate the pepper with: openssl rand -base64 32
# It must be at least 32 characters. Rotating it invalidates every token.
API_TOKEN_PEPPER=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional comma-separated origins allowed to call /api from a browser.
# https://wings.nopejs.me and localhost are already allowed. No wildcard.
API_ALLOWED_ORIGINS=

# Production: set to https://wings.nopejs.me so the OAuth issuer and token
# binding never come from the request's Host. Leave empty locally.
API_PUBLIC_ORIGIN=

# On Vercel, scope API_TOKEN_PEPPER and SUPABASE_SERVICE_ROLE_KEY to Production
# only. Preview deployments then answer /api with 503 instead of running branch
# code against production data.