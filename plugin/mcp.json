{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "wings": {
      "type": "streamable-http",
      "url": "https://wings.nopejs.me/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["read", "write"]
          }
        }
      }
    }
  }
}
